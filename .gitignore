# Environment & secrets
.env
.env.*
!.env.example

# Claude CLI state
.claude/

# Python virtual environments
.venv/
venv/
env/
# V69 M62 S3D — the isolated environment the optional training profile is installed
# into. `.venv/` above matches only that exact name, so the multi-gigabyte torch tree a
# LoRA smoke needs would otherwise be an untracked file the next `git add -A` commits.
.venv-training-smoke/
.venv-training*/
# V69 M62 S3I.1 — the Linux-native evaluation runtime. `python -m venv` writes its own
# `.gitignore` inside the tree, but that is the environment protecting the repository
# from itself; the repository states the policy here so it survives a venv built any
# other way.
.venv-m62-eval-linux/
.venv-m62-eval*/
# V69 M62 S3J.1 — the Linux-native TRAINING runtime, deliberately SEPARATE from the
# evaluation one above. The evaluation venv is the runtime the S3I measurement of record
# was taken in and must stay immutable; the training profile additionally needs
# `datasets` and `trl`, so it gets its own tree rather than an upgrade of that one.
.venv-m62-train-linux/
.venv-m62-train*/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Distribution / build
dist/
build/
*.egg-info/
*.egg

# Test & coverage
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# OPSEC — private intelligence directory
brain/
!brain.example/

# Local data stores
.chroma_db/
jarvis.log
*.log

# Runtime logs tree (hunt results, reports, intel_fusion.db, etc.)
logs/

# v27.0 HMAC telemetry signing keys — NEVER commit
jarvis/core/telemetry_keys.json
jarvis/core/trust_profile.json
jarvis/core/feed_hashes.json

# v34.0 — Paranoid Fortress security files (NEVER commit)
jarvis/core/integrity_baseline.json
jarvis/logs/stix_exports/
jarvis/core/sigma_rules/
jarvis/logs/sessions/

# v46.0 — unified config (may hold telegram/API secrets — NEVER commit)
jarvis_config.yaml

# Test/runtime artifacts (audit trail, triage queue, forensics & GRC reports)
tactic_audit.jsonl
triage_queue/
jarvis/logs/*.jsonl
# v58.0 COGNITIVE CORE — persistent task memory (covered by *.jsonl above; explicit)
jarvis/logs/task_memory.jsonl
jarvis/logs/forensics/
jarvis/logs/grc_reports/

# v69 M62 TRAINING GYM — teacher packets, imported reviews, replay ledger and
# provider audit trail. Generated artifacts that quote task material and model
# output; they are reviewed locally and NEVER committed.
jarvis/logs/training_gym/
training_gym_artifacts/
teacher_packets/

# v69 M62 S2d TRAINING GYM DATASETS — candidates, transition and revocation ledgers,
# split manifests, versioned datasets and SFT/preference exports. Every one of these
# quotes task material and the exact bytes a human approved for training; they are
# reviewed locally and NEVER committed or packaged.
dataset_candidates/
training_gym_datasets/
training_gym_exports/
jarvis/logs/training_gym_datasets/

# v69 M62 S3B TRAINING GYM EXECUTION — run directories, adapters, checkpoints, the
# quarantine tree and the plan-consumption ledger. These name the exact dataset digests
# a model was fitted on and hold real adapter weights; they are reviewed locally and
# NEVER committed or packaged.
training_runs/
training_adapters/
training_checkpoints/
training_quarantine/
training_runs.jsonl
jarvis/logs/training_runs/

# v69 M62 S3C ADAPTER EVALUATION — evaluation generations, held-out task packs, both
# arms' responses, paired comparisons, reports, the plan-consumption ledger, the
# quarantine tree and Model Registry proposal documents. Every one of these quotes
# held-out task material and model output; they are reviewed locally and NEVER committed
# or packaged.
evaluation_runs/
evaluation_artifacts/
evaluation_reports/
evaluation_quarantine/
model_candidate_proposals/
evaluation_runs.jsonl
jarvis/logs/evaluation_runs/
jarvis/evaluation/evaluations/
jarvis/evaluation/reports/
jarvis/evaluation/proposals/
jarvis/evaluation/quarantine/
