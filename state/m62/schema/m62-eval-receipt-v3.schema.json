{
  "$id": "m62-eval-receipt-v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Root-independent, tracked evidence that ONE identified candidate, built from ONE identified training receipt and ONE identified adapter, completed ONE held-out evaluation against ONE identified baseline under ONE spent single-use authority, and that its EVALUATED_* status claim is REDERIVABLE from the body-free decision evidence it carries rather than asserted by it. v3 seals an EXISTING measurement after the fact: it binds the evaluation source through a pre-repair measurement witness and names the seal implementation source separately, because after a post-live repair they are legitimately different commits. Its canonical bytes are canonical JSON encoded UTF-8, so production decision text is preserved exactly. It is EVIDENCE OF AN OPERATION and never AUTHORITY FOR ANOTHER: it grants no retry, no second evaluation, no promotion, no activation, no registry mutation and no release. receipt_hash proves payload integrity only -- not human authorisation, not execution authenticity, not who ran the command.",
  "properties": {
    "authority": {
      "additionalProperties": false,
      "properties": {
        "bound_plan_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "form": {
          "const": "EVAL:<plan-hash>"
        },
        "grants_no_further_authority": {
          "const": true
        },
        "holdout_commit_count": {
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        },
        "human_authorization": {
          "const": "external_milestone_authority"
        },
        "plan_consumption_count": {
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        },
        "retry_authorized": {
          "const": false
        },
        "seal_consumed_no_authority": {
          "const": true
        },
        "spent_by_the_run_this_receipt_describes": {
          "const": true
        },
        "token_literal_recorded": {
          "const": false
        }
      },
      "required": [
        "bound_plan_hash",
        "form",
        "grants_no_further_authority",
        "holdout_commit_count",
        "human_authorization",
        "plan_consumption_count",
        "retry_authorized",
        "seal_consumed_no_authority",
        "spent_by_the_run_this_receipt_describes",
        "token_literal_recorded"
      ],
      "type": "object"
    },
    "baseline": {
      "additionalProperties": false,
      "properties": {
        "base_model_identity_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "model_id": {
          "maxLength": 320,
          "minLength": 1,
          "type": "string"
        },
        "reference_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "tokenizer_identity_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "base_model_identity_hash",
        "model_id",
        "reference_hash",
        "revision",
        "tokenizer_identity_hash"
      ],
      "type": "object"
    },
    "candidate": {
      "additionalProperties": false,
      "properties": {
        "adapter_artifact_set_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "adapter_manifest_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "adapter_reference_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "adapter_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "candidate_id": {
          "maxLength": 320,
          "minLength": 1,
          "type": "string"
        },
        "identity_source": {
          "const": "training_receipt"
        },
        "status_claim": {
          "enum": [
            "EVALUATED_ELIGIBLE_FOR_HUMAN_REVIEW",
            "EVALUATED_NEEDS_MORE_EVIDENCE",
            "EVALUATED_NOT_ELIGIBLE",
            "EVALUATED_QUARANTINED"
          ]
        }
      },
      "required": [
        "adapter_artifact_set_hash",
        "adapter_manifest_hash",
        "adapter_reference_hash",
        "adapter_sha256",
        "candidate_id",
        "identity_source",
        "status_claim"
      ],
      "type": "object"
    },
    "canonical_encoding": {
      "const": "canonical JSON (scripts.verify_m62_control_plane.canonical_json) encoded UTF-8"
    },
    "decision_evidence": {
      "additionalProperties": false,
      "properties": {
        "bootstrap": {
          "additionalProperties": false,
          "properties": {
            "ci_high": {
              "type": "number"
            },
            "ci_low": {
              "type": "number"
            },
            "claim": {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            "confidence_level": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "error_accounting": {
              "maxLength": 320,
              "minLength": 1,
              "type": "string"
            },
            "excludes_regression_margin": {
              "type": "boolean"
            },
            "indicates_regression": {
              "type": "boolean"
            },
            "iterations": {
              "maximum": 10000000,
              "minimum": 0,
              "type": "integer"
            },
            "limitations": {
              "items": {
                "maxLength": 1000,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            "losses": {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            "mean_delta": {
              "type": "number"
            },
            "median_delta": {
              "type": "number"
            },
            "method": {
              "maxLength": 320,
              "minLength": 1,
              "type": "string"
            },
            "n_excluded": {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            "n_missing": {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            "n_pairs": {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            "observed_improvement": {
              "type": "boolean"
            },
            "p_value_reported": {
              "const": false
            },
            "regression_margin": {
              "type": "number"
            },
            "seed": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "statistics_version": {
              "maxLength": 320,
              "minLength": 1,
              "type": "string"
            },
            "ties": {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            "verdict": {
              "enum": [
                "sufficient",
                "small_sample",
                "insufficient_evidence",
                "invalid"
              ]
            },
            "wins": {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "ci_high",
            "ci_low",
            "claim",
            "confidence_level",
            "error_accounting",
            "excludes_regression_margin",
            "indicates_regression",
            "iterations",
            "limitations",
            "losses",
            "mean_delta",
            "median_delta",
            "method",
            "n_excluded",
            "n_missing",
            "n_pairs",
            "observed_improvement",
            "p_value_reported",
            "regression_margin",
            "seed",
            "statistics_version",
            "ties",
            "verdict",
            "wins"
          ],
          "type": "object"
        },
        "canonical_decision": {
          "additionalProperties": false,
          "properties": {
            "activates_model": {
              "const": false
            },
            "blockers": {
              "items": {
                "maxLength": 1000,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 128,
              "type": "array"
            },
            "eligibility": {
              "maxLength": 320,
              "minLength": 1,
              "type": "string"
            },
            "empirical_status": {
              "maxLength": 320,
              "minLength": 1,
              "type": "string"
            },
            "human_review_required": {
              "type": "boolean"
            },
            "promotes_model": {
              "const": false
            },
            "rationale": {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            "warnings": {
              "items": {
                "maxLength": 1000,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 128,
              "type": "array"
            }
          },
          "required": [
            "activates_model",
            "blockers",
            "eligibility",
            "empirical_status",
            "human_review_required",
            "promotes_model",
            "rationale",
            "warnings"
          ],
          "type": "object"
        },
        "carries_non_ascii_decision_text": {
          "type": "boolean"
        },
        "decision_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "empirical_status": {
          "maxLength": 320,
          "minLength": 1,
          "type": "string"
        },
        "gate_report": {
          "additionalProperties": false,
          "properties": {
            "blocking_count": {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            "evaluated_gates": {
              "items": {
                "maxLength": 320,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 128,
              "type": "array"
            },
            "findings": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "gate": {
                    "maxLength": 320,
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "security",
                      "quality",
                      "family",
                      "coverage",
                      "statistical",
                      "operational"
                    ]
                  },
                  "message": {
                    "maxLength": 1000,
                    "minLength": 1,
                    "type": "string"
                  },
                  "observed": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "maxLength": 320,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "severity": {
                    "enum": [
                      "blocking",
                      "warning",
                      "info"
                    ]
                  },
                  "threshold": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "maxLength": 320,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "threshold_calibrated": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "gate",
                  "kind",
                  "message",
                  "observed",
                  "severity",
                  "threshold",
                  "threshold_calibrated"
                ],
                "type": "object"
              },
              "maxItems": 128,
              "type": "array"
            },
            "gates_version": {
              "maxLength": 320,
              "minLength": 1,
              "type": "string"
            },
            "limitations": {
              "items": {
                "maxLength": 1000,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            "passed": {
              "type": "boolean"
            },
            "security_blocking_count": {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            "security_is_a_veto_not_a_weight": {
              "const": true
            },
            "thresholds_are_calibrated": {
              "type": "boolean"
            },
            "warning_count": {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "blocking_count",
            "evaluated_gates",
            "findings",
            "gates_version",
            "limitations",
            "passed",
            "security_blocking_count",
            "security_is_a_veto_not_a_weight",
            "thresholds_are_calibrated",
            "warning_count"
          ],
          "type": "object"
        },
        "non_ascii_codepoints": {
          "items": {
            "maxLength": 16,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "rederived_by": {
          "const": "training_gym.evaluation.reports.decision_from_evidence"
        },
        "report_serialization_state": {
          "maxLength": 320,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "bootstrap",
        "canonical_decision",
        "carries_non_ascii_decision_text",
        "decision_hash",
        "empirical_status",
        "gate_report",
        "non_ascii_codepoints",
        "rederived_by",
        "report_serialization_state"
      ],
      "type": "object"
    },
    "evaluation_generation": {
      "maximum": 100000,
      "minimum": 1,
      "type": "integer"
    },
    "evaluation_id": {
      "maxLength": 320,
      "minLength": 1,
      "type": "string"
    },
    "evaluation_milestone": {
      "pattern": "^S[0-9A-Z.]{1,10}$",
      "type": "string"
    },
    "evaluation_source": {
      "additionalProperties": false,
      "properties": {
        "derived_from": {
          "const": "measurement_witness"
        },
        "evaluation_source_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "evaluation_source_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "evaluation_source_tree_oid": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "evidence_level": {
          "const": "the measurement witness was written in a clean worktree at this commit, before the repair moved HEAD, and its Git first parent is this commit; that is repository provenance and not proof of which bytes executed"
        }
      },
      "required": [
        "derived_from",
        "evaluation_source_commit",
        "evaluation_source_digest",
        "evaluation_source_tree_oid",
        "evidence_level"
