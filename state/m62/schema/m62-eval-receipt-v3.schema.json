        },
        "metrics_summary_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "pack_manifest_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "report_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "bootstrap_report_hash",
        "comparison_manifest_hash",
        "evaluation_artifact_tree_hash",
        "evaluation_manifest_hash",
        "files",
        "gate_report_hash",
        "metrics_summary_hash",
        "pack_manifest_hash",
        "report_hash"
      ],
      "type": "object"
    },
    "execution": {
